[
  {
    "segment_id": "s001",
    "start": 0.0,
    "end": 9.858,
    "text": "今天我们用一个简单例子，理解梯度下降如何帮助模型学习。",
    "words": []
  },
  {
    "segment_id": "s002",
    "start": 10.008,
    "end": 18.572,
    "text": "模型预测与真实答案之间的差距，可以用损失函数来衡量。",
    "words": []
  },
  {
    "segment_id": "s003",
    "start": 18.722,
    "end": 28.988,
    "text": "训练的目标，是不断调整参数，让损失函数的数值逐渐减小。",
    "words": []
  },
  {
    "segment_id": "s004",
    "start": 29.138,
    "end": 40.297,
    "text": "梯度下降沿着梯度的反方向更新参数，就像沿山坡走向谷底。",
    "words": []
  },
  {
    "segment_id": "s005",
    "start": 40.447,
    "end": 50.677,
    "text": "接下来讨论学习率，它决定每次参数更新迈出多大的步子。",
    "words": []
  },
  {
    "segment_id": "s006",
    "start": 50.827,
    "end": 60.703,
    "text": "学习率过大，可能在最低点附近来回震荡，甚至无法收敛。",
    "words": []
  },
  {
    "segment_id": "s007",
    "start": 60.853,
    "end": 72.082,
    "text": "学习率过小，训练虽然更平稳，但到达较好结果需要更长时间。",
    "words": []
  },
  {
    "segment_id": "s008",
    "start": 72.232,
    "end": 80.988,
    "text": "因此，使用梯度下降时，需要结合损失曲线调整学习率。",
    "words": []
  },
  {
    "segment_id": "s009",
    "start": 81.138,
    "end": 91.197,
    "text": "最后，我们用损失曲线检查训练是否有效，不能只看运行次数。",
    "words": []
  },
  {
    "segment_id": "s010",
    "start": 91.347,
    "end": 100.89,
    "text": "如果损失持续下降，通常说明参数更新正在改善训练目标。",
    "words": []
  },
  {
    "segment_id": "s011",
    "start": 101.04,
    "end": 110.767,
    "text": "如果损失出现震荡，可以检查学习率，并核对数据和实现。",
    "words": []
  },
  {
    "segment_id": "s012",
    "start": 110.917,
    "end": 123.851,
    "text": "总结一下，梯度下降负责更新方向，学习率控制步长，损失函数帮助评估效果。",
    "words": []
  }
]
